// Adapted from https://github.com/jenkinsci/bom/blob/master/Jenkinsfile

def pluginsByRepository
def line = 'weekly'
def maxSplitsPerLine = 20
def splits = [:]

@NonCPS
def parsePlugins(plugins) {
  def pluginsByRepository = [:]
  plugins.each { plugin ->
    def splits = plugin.split('\t')
    pluginsByRepository[splits[0].split('/')[1]] = splits[1].split(',')
  }
  pluginsByRepository
}

timestamps {
    node('linux') {
        def mvn = tool name: 'maven-3.9', type: 'maven'
        def jdk = tool name: "jdk21", type: 'jdk'
        git url: 'https://github.com/jenkinsci-cert/bom', branch: params.BOM_BRANCH, credentialsId: 'github'
        withEnv([
                "PATH+MVN=${mvn}/bin",
                "PATH+JDK=${jdk}/bin",
                "JAVA_HOME=${jdk}",
                "M2_HOME=${mvn}"
        ]) {
            configFileProvider([configFile(fileId: 'repo.jenkins-ci.org', variable: 'SETTINGS')]) {
                sh 'SAMPLE_PLUGIN_OPTS="-s $SETTINGS" bash prep.sh'
                stash name: "basics", includes: "pct.sh,excludes.txt,target/pct.jar,target/megawar-weekly.war"
            }
            dir('target') {
                def plugins = readFile('plugins.txt').split('\n')
                pluginsByRepository = parsePlugins(plugins)
            }
        }
    }
}

if (params.PLUGINS) {                                                                                                                                                                      
  def pluginList = params.PLUGINS.split(',').collect { it.trim() }
  pluginsByRepository = pluginsByRepository.findAll { key, value ->                                                                                                               
      value.any { it in pluginList }
  }.collectEntries { key, value ->
      [key, value.findAll { it in pluginList }]
  }
}

pluginsByRepository.eachWithIndex { repository, repoPlugins, idx ->
    def index = (idx % maxSplitsPerLine) + 1 // to get split1 to split<maxSplitsPerLine>
    def name = "split-${index}:${line}"
    splits[name] = splits[name] ?: []
    splits[name] << repository
}

def branches = [failFast: false]
splits.each { split, repositories ->
    if (repository == 'azure-credentials-plugin') {
        // skip known problematic plugin in this environment
        return
    }
    branches["${split} [${repositories.size()}]"] = {
        timestamps {
            node('linux') {
                def mvn = tool name: 'maven-3.9', type: 'maven'
                def jdk = tool name: "jdk21", type: 'jdk'
                unstash 'basics'
                repositories.eachWithIndex { repository, idx ->
                    stage("${repository} (${idx + 1}/${repositories.size()})") {
                        withEnv([
                            "PATH+MVN=${mvn}/bin",
                            "PATH+JDK=${jdk}/bin",
                            "JAVA_HOME=${jdk}",
                            "M2_HOME=${mvn}",
                            'EXTRA_MAVEN_PROPERTIES=maven.test.failure.ignore=true:surefire.rerunFailingTestsCount=1',
                            "PLUGINS=${plugins.join(',')}",
                            "LINE=${line}"
                        ]) {
                            configFileProvider([configFile(fileId: 'repo.jenkins-ci.org', variable: 'SETTINGS')]) {
                                timeout(time: 2, unit: 'HOURS') {
                                    sh 'MAVEN_ARGS="-s $SETTINGS" bash pct.sh'
                                }
                            }
                            junit(testResults: '**/target/surefire-reports/TEST-*.xml,**/target/failsafe-reports/TEST-*.xml')
                        }
                    }
                }
            }
        }
    }
}
parallel branches
